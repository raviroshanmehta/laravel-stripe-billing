{
    "name": "raviroshanmehta/laravel-stripe-billing",
    "description": "Stripe Checkout subscriptions for Laravel with verified, idempotent webhooks",
    "type": "library",
    "keywords": [
        "laravel",
        "stripe",
        "subscriptions",
        "billing",
        "webhooks",
        "saas"
    ],
    "authors": [
        {
            "name": "Ravi Roshan",
            "email": "raviroshanmehta@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "stripe/stripe-php": ">=16.0 <24.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "RaviRoshan\\StripeBilling\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RaviRoshan\\StripeBilling\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RaviRoshan\\StripeBilling\\StripeBillingServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
